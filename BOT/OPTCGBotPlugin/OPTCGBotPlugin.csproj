<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <AssemblyName>OPTCGBotPlugin</AssemblyName>
    <RootNamespace>OPTCGBotPlugin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Pasta do JOGO. Estava CRAVADA em todas as referencias ate
       28/08/2026 (bloco 722), o que impedia instalar em outra maquina:
       cada HintPath aponta pra uma DLL que vive na instalacao do jogo, e
       esse caminho muda de maquina pra maquina.
       Agora vem de fora, nesta ordem de precedencia:
         1. dotnet build -p:GameDir="D:\Jogos\...\Builds_Windows"
         2. variavel de ambiente OPTCG_GAME_DIR
         3. o default abaixo (a maquina original) -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">$(OPTCG_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">E:\Games\OnePieceSimulador\Builds_Windows</GameDir>
    <ManagedDir>$(GameDir)\OPTCGSim_Data\Managed</ManagedDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <!-- Copia o .dll final para a pasta de plugins do BepInEx automaticamente -->
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)"
          DestinationFolder="$(GameDir)\BepInEx\plugins\" />
  </Target>

  <ItemGroup>
    <!-- BepInEx 5 + Harmony (DLLs locais da instalacao do jogo) -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- DLLs do jogo (nao distribuir, uso apenas local para compilar) -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Facades do runtime do jogo (Unity Mono = netstandard 2.1) -->
    <Reference Include="netstandard">
      <HintPath>$(ManagedDir)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Net.Http">
      <HintPath>$(ManagedDir)\System.Net.Http.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
